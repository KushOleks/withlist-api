# Copy to .env and fill BOTH secrets before starting Compose.
POSTGRES_USER=wishlist
POSTGRES_DB=wishlist
POSTGRES_PASSWORD=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_PORT=8000
UI_PORT=8080
VITE_API_BASE=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# For running Python outside Compose, fill these separately.
DB_USER=wishlist
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wishlist
DB_SSLMODE=disable
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
